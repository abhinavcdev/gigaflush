// Deploys the NodeMinus landing page as a Cloudflare Worker with static
// assets (no server code — assets only).
//
//   npx wrangler deploy -c site/wrangler.jsonc
//
// Add a custom domain afterwards in the Cloudflare dashboard
// (Workers & Pages → nodeminus-site → Settings → Domains & Routes).
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "nodeminus-site",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
