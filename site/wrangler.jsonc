// Deploys the Gigaflush landing page (Astro static build) as a Cloudflare
// Worker with static assets only, so no request ever runs Worker code:
//
//   npm run site:deploy   (from the repo root)
//
// www.gigaflush.com is redirected by the separate Worker in ./www-redirect.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "gigaflush-site",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    // Canonical URLs have no trailing slash: /blog serves blog/index.html
    // and /blog/ redirects to /blog.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "gigaflush.com", "custom_domain": true }]
}
