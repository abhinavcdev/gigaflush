---
import Mark from "../Mark.astro";
interface Props {
  title?: string;
}
const { title = "Do it in one pass with Gigaflush" } = Astro.props;
---

<aside class="cta">
  <Mark size={44} />
  <div class="copy">
    <b>{title}</b>
    <p>Scan every project for node_modules, Rust target, Flutter build and tool caches. Review each path, then reclaim the space. Free and open source for macOS, Windows and Linux.</p>
  </div>
  <a href="/#download" class="key key-primary" data-press>Download free →</a>
</aside>

<style>
  .cta {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 40px 0;
    padding: 22px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background:
      radial-gradient(80% 120% at 0% 0%, var(--glow), transparent),
      var(--content);
    box-shadow: var(--card-shadow);
  }
  .copy {
    flex: 1;
  }
  b {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  p {
    margin: 4px 0 0 !important;
    font-size: 14px !important;
    color: var(--muted);
  }
  .key {
    flex-shrink: 0;
    text-decoration: none !important;
    color: var(--page) !important;
  }
  @media (max-width: 640px) {
    .cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
