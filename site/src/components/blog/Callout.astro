---
interface Props {
  type?: "tip" | "warn" | "note";
  title?: string;
}
const { type = "note", title } = Astro.props;
const icons = { tip: "✦", warn: "!", note: "i" };
---

<aside class:list={["callout", type]}>
  <span class="icon" aria-hidden="true">{icons[type]}</span>
  <div>
    {title && <b>{title}</b>}
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: flex;
    gap: 14px;
    margin: 28px 0;
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 15px;
  }
  .icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 12px;
    font-weight: 700;
    background: var(--selected);
    color: var(--accent);
  }
  .warn .icon {
    background: color-mix(in srgb, var(--danger) 14%, transparent);
    color: var(--danger);
  }
  .tip .icon {
    background: var(--success-soft);
    color: var(--success);
  }
  b {
    display: block;
    margin-bottom: 2px;
    color: var(--text);
  }
  div :global(p) {
    margin: 0 !important;
  }
</style>
