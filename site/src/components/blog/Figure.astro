---
// An Anatomy figure: the drawing is built here at build time, and its live
// module (the same file) is loaded in the browser to move it.
import "../../anatomy/theme.css";

interface Props {
  name: string;
  still?: boolean;
}
const { name, still = false } = Astro.props;
const modules = import.meta.glob("../../anatomy/figures/*.mjs", { eager: true }) as Record<string, any>;
const mod = modules[`../../anatomy/figures/${name}.mjs`];
if (!mod) throw new Error(`Unknown figure: ${name}`);
const { meta } = mod;
const { svg } = mod.figure();
---

<div class="iso fig-wrap" data-anatomy={still ? undefined : name}>
  <figure class="iso-figure">
    <div class="iso-plate">
      <div
        class="iso-stage"
        tabindex={still ? undefined : 0}
        role={still ? undefined : meta.role ?? "slider"}
        aria-label={still ? undefined : meta.control}
        set:html={svg}
      />
    </div>
  </figure>
</div>

<script>
  const modules = import.meta.glob("../../anatomy/figures/*.mjs");
  document.querySelectorAll<HTMLElement>("[data-anatomy]").forEach(async (root) => {
    if (root.dataset.mounted) return;
    root.dataset.mounted = "1";
    const load = modules[`../../anatomy/figures/${root.dataset.anatomy}.mjs`];
    if (!load) return;
    const mod: any = await load();
    // Figures report a text readout as they move; it isn't shown on the page.
    mod.mount(root.querySelector(".iso-stage"), document.createElement("span"));
  });
</script>

<style>
  .fig-wrap {
    margin: 36px 0 40px;
  }
  .iso-figure {
    margin: 0;
  }
  .iso-plate {
    padding: 28px 24px;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line);
  }
  @media (max-width: 560px) {
    .iso-plate {
      padding: 20px 12px;
    }
  }
</style>
