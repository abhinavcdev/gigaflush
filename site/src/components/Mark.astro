---
// The Gigaflush mark (generated by brand/make.py). With a tile it's the app
// icon; without, the bare tap-G. Either way it follows the site theme.
interface Props {
  size?: number;
  tile?: boolean;
}
const { size = 28, tile = true } = Astro.props;
const [light, dark] = tile ? ["/brand/app-icon-light.svg", "/brand/app-icon.svg"] : ["/brand/mark-light.svg", "/brand/mark-dark.svg"];
---

<span class:list={["mark", { "mark--tile": tile }]} style={`--size:${size}px`} aria-hidden="true">
  <img class="is-light" src={light} width={size} height={size} alt="" decoding="async" />
  <img class="is-dark" src={dark} width={size} height={size} alt="" decoding="async" />
</span>

<style>
  .mark {
    width: var(--size);
    height: var(--size);
    display: inline-grid;
    flex-shrink: 0;
  }
  img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }
  /* The app icon's SVG keeps Apple's icon margin; scale it to fill the box. */
  .mark--tile img {
    transform: scale(1.24);
  }
  .is-dark {
    visibility: hidden;
  }
  :global(:root[data-theme="dark"]) .is-light {
    visibility: hidden;
  }
  :global(:root[data-theme="dark"]) .is-dark {
    visibility: visible;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .is-light {
      visibility: hidden;
    }
    :global(:root:not([data-theme="light"])) .is-dark {
      visibility: visible;
    }
  }
</style>
