---
interface Props {
  size?: number;
  tile?: boolean;
}
const { size = 28, tile = true } = Astro.props;
---

<span class:list={["mark", { "mark--tile": tile }]} style={`--size:${size}px`} aria-hidden="true">
  <svg viewBox="194 194 636 636" fill="none" stroke-width="118" stroke-linecap="round" stroke-linejoin="round">
    <path class="mark-arc" d="M687.3 317.3A262 262 0 1 0 512 774" />
    <path class="mark-tail" d="M512 774A262 262 0 0 0 774 512H552" />
  </svg>
</span>

<style>
  .mark {
    width: var(--size);
    height: var(--size);
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
  }
  .mark svg {
    width: 100%;
    height: 100%;
    stroke-width: 118;
  }
  .mark--tile {
    border-radius: calc(var(--size) * 0.25);
    background: linear-gradient(#2a2c2f, #141516);
    box-shadow: inset 0 0 0 1px #ffffff17;
  }
  .mark--tile svg {
    width: 58%;
    height: 58%;
  }
  .mark-arc {
    stroke: #f4f5f1;
  }
  .mark:not(.mark--tile) .mark-arc {
    stroke: var(--text);
  }
  .mark-tail {
    stroke: #4a9dff;
  }
</style>
