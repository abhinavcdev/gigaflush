---
import Icon from "./Icon.astro";
import { GITHUB_URL } from "../config";
---

<section class="section star" id="star">
  <div class="inner card" data-reveal>
    <div class="logo" aria-hidden="true">
      <Icon name="ph:github-logo" size={30} />
    </div>
    <div class="copy">
      <h2>Saved you a few gigabytes?</h2>
      <p>Gigaflush is free and open source. A star on GitHub helps other developers find it.</p>
    </div>
    <div class="actions">
      <a href={GITHUB_URL} class="key key-primary" data-press>
        <Icon name="ph:star-fill" size={15} class="icon-star" />
        Star on GitHub
      </a>
      <a href={`${GITHUB_URL}/issues`} class="more-link">Report an issue</a>
    </div>
  </div>
</section>

<style>
  .star {
    padding-block: 64px;
  }
  .inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 32px 36px;
    background:
      radial-gradient(70% 140% at 0% 0%, var(--glow), transparent),
      var(--surface);
  }
  .logo {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: var(--content);
    color: var(--text);
    box-shadow: var(--card-shadow), inset 0 0 0 1px var(--line);
  }
  h2 {
    font-family: var(--display);
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600;
    letter-spacing: -0.022em;
  }
  p {
    margin-top: 6px;
    max-width: 40em;
    font-size: 15px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .actions {
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .actions .more-link {
    font-size: 14px;
  }
  .key :global(.icon-star) {
    color: #f5b301;
  }
  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
      justify-items: start;
      padding: 28px 24px;
    }
    .actions {
      justify-items: start;
    }
  }
</style>
