---
// Renders an Iconify icon to inline SVG at build time (no runtime JS).
// Sets: ph (Phosphor UI icons), devicon-plain (mono logos), logos (color).
import { getIconData, iconToSVG, replaceIDs } from "@iconify/utils";
import ph from "@iconify-json/ph/icons.json";
import devicon from "@iconify-json/devicon-plain/icons.json";
import logos from "@iconify-json/logos/icons.json";

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}
const sets: Record<string, any> = { ph, "devicon-plain": devicon, logos };
const { name, size = 18, class: cls, label } = Astro.props;
const [prefix, icon] = name.split(":");
const data = getIconData(sets[prefix], icon);
if (!data) throw new Error(`Unknown icon: ${name}`);
const svg = iconToSVG(data, { height: size });
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={svg.attributes.viewBox}
  width={svg.attributes.width}
  height={size}
  class:list={["icon", cls]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={replaceIDs(svg.body)}
/>
