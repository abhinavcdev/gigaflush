---
import PostCard from "./blog/PostCard.astro";
import { getPosts } from "../lib/blog";
const posts = (await getPosts()).slice(0, 3);
---

<section class="section">
  <div class="top">
    <div class="section-head" data-reveal>
      <h2>Where your disk space <span class="dim">actually goes.</span></h2>
    </div>
    <a href="/blog" class="key key-ghost" data-press data-reveal>All articles →</a>
  </div>
  <div class="grid">
    {posts.map((p, i) => <div data-reveal style={`--d:${i}`}><PostCard post={p} /></div>)}
  </div>
</section>

<style>
  .top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
