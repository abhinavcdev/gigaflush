---
import Base from "../layouts/Base.astro";
import { guides, platforms } from "../data/cleanup";
import { getPosts } from "../lib/blog";
import { GITHUB_URL, RELEASES_URL } from "../config";

const posts = await getPosts();
const sections = [
  {
    title: "Product",
    links: [
      { label: "Home", href: "/" },
      { label: "How it works", href: "/#how" },
      { label: "Ecosystems", href: "/#ecosystems" },
      { label: "Idle dev servers", href: "/#servers" },
      { label: "Download", href: "/#download" },
      { label: "Tip jar", href: "/#tip" },
    ],
  },
  {
    title: "Download by platform",
    links: platforms.map((p) => ({ label: `Gigaflush for ${p.name}`, href: `/${p.slug}` })),
  },
  {
    title: "Cleanup guides",
    href: "/guides",
    links: guides.map((g) => ({ label: g.h1, href: `/clean/${g.slug}` })),
  },
  {
    title: "Blog",
    href: "/blog",
    links: posts.map((p) => ({ label: p.data.title, href: `/blog/${p.id}` })),
  },
  {
    title: "Help and legal",
    links: [
      { label: "Support", href: "/support" },
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
  {
    title: "Open source",
    links: [
      { label: "Source on GitHub", href: GITHUB_URL },
      { label: "Latest release", href: RELEASES_URL },
      { label: "Changelog", href: `${GITHUB_URL}/blob/main/CHANGELOG.md` },
    ],
  },
  {
    title: "For machines",
    links: [
      { label: "XML sitemap", href: "/sitemap-index.xml" },
      { label: "RSS feed", href: "/rss.xml" },
      { label: "llms.txt", href: "/llms.txt" },
    ],
  },
];
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: Astro.site?.href },
    { "@type": "ListItem", position: 2, name: "Sitemap", item: new URL("/sitemap", Astro.site).href },
  ],
};
---

<Base title="Sitemap: every Gigaflush page" description="Every page on gigaflush.com: downloads for each platform, cleanup guides for every developer folder, the blog, support and legal pages." schema={schema}>
  <main class="frame">
    <header class="head">
      <p class="mono-label" data-reveal>Sitemap</p>
      <h1 data-reveal style="--d:1">Everything <span class="dim">in one place.</span></h1>
    </header>
    <div class="grid">
      {
        sections.map((s, i) => (
          <section data-reveal style={`--d:${i % 3}`}>
            <h2>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</h2>
            <ul>
              {s.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</Base>

<style>
  .head {
    padding: 72px 40px 48px;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    margin-top: 16px;
    font-size: clamp(38px, 5.4vw, 68px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .dim {
    color: var(--faint);
  }
  .grid {
    columns: 3 280px;
    column-gap: 48px;
    padding: 48px 40px 96px;
  }
  section {
    break-inside: avoid;
    margin-bottom: 48px;
  }
  h2 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  h2 a:hover {
    color: var(--accent);
  }
  ul {
    list-style: none;
    display: grid;
    gap: 10px;
    margin-top: 14px;
    font-size: 15px;
    color: var(--muted);
  }
  li a {
    transition: color 160ms;
  }
  li a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 640px) {
    .head {
      padding: 56px 20px 36px;
    }
    .grid {
      padding: 36px 20px 64px;
    }
  }
</style>
