---
import Base from "../../layouts/Base.astro";
import CommandTabs from "../../components/react/CommandTabs.tsx";
import AppCta from "../../components/blog/AppCta.astro";
import { guides } from "../../data/cleanup";
import { getPosts } from "../../lib/blog";

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const posts = (await getPosts()).filter((p) => g.posts.includes(p.id));
const others = guides.filter((x) => x.slug !== g.slug);
const url = new URL(`/clean/${g.slug}`, Astro.site).href;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [{ q: `Is it safe to delete ${g.folders.join(" and ")}?`, a: g.answer }, ...g.faqs].map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: g.title,
    description: g.description,
    step: [
      { "@type": "HowToStep", name: "Find the folders", text: `Search your projects for ${g.folders.join(", ")} next to ${g.markers.join(" or ")}.` },
      { "@type": "HowToStep", name: "Measure them", text: "Check the size of each folder before removing anything." },
      { "@type": "HowToStep", name: "Delete the ones you don't need", text: `Remove them; rebuild later with: ${g.rebuild}` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: Astro.site?.href },
      { "@type": "ListItem", position: 2, name: "Guides", item: new URL("/guides", Astro.site).href },
      { "@type": "ListItem", position: 3, name: g.h1, item: url },
    ],
  },
];
---

<Base title={g.title} description={g.description} schema={schema}>
  <main class="frame">
    <header class="head">
      <nav class="mono-label" data-reveal><a href="/guides">Guides</a> / {g.ecosystem}</nav>
      <h1 data-reveal style="--d:1">{g.h1}</h1>
      <div class="chips" data-reveal style="--d:2">
        {g.folders.map((f) => <code class="chip gen">{f}</code>)}
        <span class="mono-label">next to</span>
        {g.markers.map((m) => <code class="chip marker">{m}</code>)}
      </div>
    </header>

    <div class="body">
      <article class="prose">
        <section class="answer" data-reveal>
          <p class="mono-label">Quick answer</p>
          <p class="answer-text">{g.answer}</p>
          <p class="mono-label">Rebuild with <code>{g.rebuild}</code></p>
        </section>

        <h2>What is it?</h2>
        <p>{g.what}</p>

        <h2>Why does it get so big?</h2>
        <ul>{g.whyBig.map((w) => <li>{w}</li>)}</ul>

        <h2>How to clean it from the command line</h2>
        <CommandTabs client:visible id={g.slug} tabs={g.commands} />
        <p>Review what a command matches before you run anything with <code>rm -rf</code>. These deletions are permanent.</p>

        <h2>What not to delete</h2>
        <ul>{g.keep.map((k) => <li>{k}</li>)}</ul>

        <h2>How Gigaflush handles {g.ecosystem}</h2>
        <p>
          Gigaflush lists {g.folders.map((f, i) => <><code>{f}</code>{i < g.folders.length - 1 ? " and " : ""}</>)} only when {g.markers.length > 1 ? "one of " : ""}{g.markers.map((m, i) => <><code>{m}</code>{i < g.markers.length - 1 ? ", " : ""}</>)} sits right beside it, shows each folder's size, preselects nothing, and re-checks the folder immediately before deleting it. Symlinks and parent-directory paths are refused.
        </p>
        <AppCta title={`Clean every ${g.folders[0]} in one pass`} />

        <h2>FAQ</h2>
        <div class="faq">
          {g.faqs.map((f) => (
            <details name="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>

        {
          posts.length > 0 && (
            <>
              <h2>Further reading</h2>
              <ul>{posts.map((p) => <li><a href={`/blog/${p.id}`}>{p.data.title}</a></li>)}</ul>
            </>
          )
        }
      </article>
      <aside class="side">
        <p class="mono-label">Other cleanup guides</p>
        <ul>{others.map((o) => <li><a href={`/clean/${o.slug}`} data-press><b>{o.ecosystem}</b><code>{o.folders.join(" · ")}</code></a></li>)}</ul>
      </aside>
    </div>
  </main>
</Base>

<style>
  .head {
    padding: 64px 40px 40px;
    border-bottom: 1px solid var(--line);
  }
  .head a {
    color: var(--text);
  }
  h1 {
    margin-top: 18px;
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
  }
  .chip {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 13px;
  }
  .gen {
    background: var(--selected);
    color: var(--accent);
  }
  .marker {
    background: var(--success-soft);
    color: var(--success);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 720px) 260px;
    justify-content: space-between;
    gap: 48px;
    padding: 40px;
  }
  .answer {
    padding: 22px 24px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background:
      radial-gradient(80% 120% at 0% 0%, var(--success-soft), transparent),
      var(--content);
  }
  .answer-text {
    margin: 10px 0 14px !important;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text) !important;
  }
  .prose {
    min-width: 0;
    font-size: 16.5px;
    line-height: 1.75;
  }
  .prose h2 {
    margin: 48px 0 12px;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.022em;
  }
  .prose p,
  .prose li {
    color: color-mix(in srgb, var(--text) 82%, var(--page));
  }
  .prose p {
    margin: 14px 0;
  }
  .prose ul {
    padding-left: 22px;
  }
  .prose li + li {
    margin-top: 6px;
  }
  .prose :not(pre) > code {
    font-size: 0.86em;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--control);
  }
  .prose a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .faq details {
    border-bottom: 1px solid var(--line);
  }
  .faq details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 450ms var(--ease),
      content-visibility 450ms allow-discrete;
  }
  .faq details[open]::details-content {
    block-size: auto;
  }
  .faq summary {
    padding: 16px 0;
    font-weight: 500;
    cursor: pointer;
  }
  .side {
    position: sticky;
    top: 100px;
    align-self: start;
  }
  .side ul {
    list-style: none;
    display: grid;
    gap: 6px;
    margin-top: 12px;
  }
  .side a {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--content);
    font-size: 14px;
    transition: border-color 200ms;
  }
  .side a:hover {
    border-color: var(--line-strong);
  }
  .side code {
    font-size: 11.5px;
    color: var(--muted);
  }
  @media (max-width: 1000px) {
    .body {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
  }
  @media (max-width: 600px) {
    .head,
    .body {
      padding-inline: 16px;
    }
  }
</style>
