{
  "name": "gigaflush",
  "version": "0.2.0",
  "description": "System tray utility to review and remove generated project files",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:ui": "node tests/ui-smoke.cjs",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:deploy": "npm --prefix site run build && wrangler deploy -c site/wrangler.jsonc"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "playwright": "^1.64.1",
    "wrangler": "^4"
  },
  "license": "GPL-3.0-or-later"
}
